&vbat_pwr {
	/delete-property/ enable-gpios;
};

/ {
	/*
	 * XIAO nRF54L15 (cpuapp) application overlay
	 *
	 * The board pinctrl maps SPI00 to SCK P2.01 (D8), MOSI P2.02
	 * (D10), and MISO P2.04 (D9). The external LSM6DSV16X uses
	 * CS P2.07 (D7) and INT1 P1.04 (D0).
	 */

	chosen {
		zephyr,console = &uart20;
		zephyr,shell-uart = &uart20;
	};

	battery-divider {
		compatible = "voltage-divider";
		status = "okay";
		/* XIAO nRF54L15 Sense Battery: AIN7 (P1.14) with Power Control (P1.15) */
		io-channels = <&adc 7>;
		output-ohms = <1000000>;
		full-ohms = <2000000>;
		power-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
	};

	zephyr,user {
		/* LSM6DSV16X INT1 is open-drain and active low. */
		int0-gpios = <&gpio1 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};
};

/* Built-in IMU (LSM6DS3TR-C) on I2C30 */
&i2c30 {
	status = "disabled";
	clock-frequency = <I2C_BITRATE_FAST>;

	lsm6ds3tr_c: lsm6ds3tr-c@6a {
		compatible = "st,lsm6dsl";
		status = "disabled";
		reg = <0x6a>;
		irq-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		label = "lsm6ds3tr-c";
	};
};

/* SPI IMU (+ optional SPI magnetometer) */
&spi00 {
	status = "okay";
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";
	/* SPIM00 cannot synthesize the scan code's requested 10 MHz clock. */
	max-frequency = <DT_FREQ_M(8)>;
	cs-gpios = <&gpio2 7 GPIO_ACTIVE_LOW>;

	imu_spi: imu_spi@0 {
		compatible = "vnd,spi-device";
		spi-max-frequency = <DT_FREQ_M(8)>;
		label = "imu-spi";
		reg = <0>;
		/* LSM6DSV16X SPI Mode 3. */
		spi-cpol;
		spi-cpha;
	};
};

&uart20 {
	status = "okay";
};

/* uart21 RX shares P2.07 with the external IMU chip select. */
&uart21 {
	status = "disabled";
};

/* Explicitly disable I2C22 at the end of the overlay to override any base board settings */
&i2c22 {
	status = "disabled";
};
